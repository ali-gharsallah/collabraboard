{
  "name": "olive-mvp",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "test:demo": "bash tests/demo/run.sh",
    "test:smoke": "node tests/demo/smoke-screens.spec.mjs",
    "screening:data": "node services/screening/generate.mjs",
    "screening:bench": "node services/screening/bench.mjs",
    "screening:blocking": "node services/screening/bench-blocking.mjs",
    "screening:portefeuille": "node services/screening/bench-portefeuille.mjs",
    "screening:gate": "node services/screening/gate.test.mjs"
  },
  "devDependencies": {
    "eslint": "^9.9.0",
    "@eslint/js": "^9.9.0",
    "typescript-eslint": "^8.0.0",
    "globals": "^15.9.0"
  },
  "pnpm": {
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-5xrq-8626-4rwp"
      ]
    }
  }
}
