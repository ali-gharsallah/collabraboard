{ "name": "@olive/api", "version": "0.1.0",
  "scripts": { "build": "nest build", "start": "nest start", "lint": "eslint src",
    "typecheck": "tsc --noEmit", "test:unit": "jest",
    "test:rules": "bash scripts/run-rule-tests.sh", "test:e2e": "jest --config jest-e2e.config.js --runInBand",
    "prisma:migrate": "prisma migrate dev", "prisma:push": "prisma db push",
    "prisma:post": "prisma db execute --file prisma/post-deploy-v2.sql --schema prisma/schema.prisma" },
  "dependencies": { "@nestjs/common": "^10.3.0", "@nestjs/core": "^10.3.0",
    "@nestjs/platform-express": "^10.3.0", "@prisma/client": "^5.10.0",
    "@olive/shared": "workspace:*", "jsonwebtoken": "^9.0.2", "zod": "^3.23.0" },
  "devDependencies": { "prisma": "^5.10.0", "typescript": "^5.3.3", "jest": "^29.7.0" } }
