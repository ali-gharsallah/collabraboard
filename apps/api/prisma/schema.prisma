// ── MOD-43 Formations & Certifications (R231→R238, lot 50) ──────────────────
// Le référentiel des formations est 100% tenant (registre `trainingCatalog`, R231).
// L'assignation porte le cycle de vie (R232) ; la complétion est un événement
// (TRAINING_COMPLETED) avec attestation GED. Mode de validation = paramètre tenant
// (R235) : AUTO ou VALIDATED (visa uniforme R15, exclusion 4-yeux R13).
model TrainingAssignment {
  id               String    @id @default(uuid()) @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  userId           String    @map("user_id") @db.Uuid          // le collaborateur
  formationCode    String    @map("formation_code")
  echeance         String                                      // ISO date (R232)
  statut           String    @default("ASSIGNED")              // ASSIGNED|IN_PROGRESS|COMPLETED|EXPIRED (R232)
  attestationDocId String?   @map("attestation_doc_id")        // pièce GED (R232)
  visaStatut       String?   @map("visa_statut")               // R235 mode VALIDATED : PENDING|SIGNED (null = AUTO)
  visePar          String?   @map("vise_par") @db.Uuid
  viseAt           DateTime? @map("vise_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  @@index([tenantId, userId])
  @@map("training_assignments")
}

// Certification : date d'obtention + expiration. APPEND-ONLY (R234) : un renouvellement
// est une NOUVELLE ligne, jamais un écrasement — le rejeu certifiant (R238) relit l'historique.
model Certification {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  code      String                                          // ex. CROSS_BORDER_AE
  obtenueLe String   @map("obtenue_le")                     // ISO date
  expireLe  String   @map("expire_le")                      // ISO date
  docId     String?  @map("doc_id")
  at        DateTime @default(now())
  @@index([tenantId, userId, code])
  @@map("certifications")
}

// Attestation de complétion : APPEND-ONLY (R234) — l'historique complet est rejouable (R48).
model TrainingAttestation {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  formationCode String   @map("formation_code")
  docId         String   @map("doc_id")
  at            DateTime @default(now())
  @@index([tenantId, userId])
  @@map("training_attestations")
}

// ── MOD-75 Business Trip (R222→R230, lot 51) ────────────────────────────────
// Le voyage est un objet à cycle de vie événementiel (R222). Destinations/clients/avis/signaux
// sont des projections calculées à la soumission (R223/R224/R228) ; l'approbation est un visa
// uniforme R15 (R225) — le voyageur ne vise jamais son propre voyage (R13). Rejeu avec
// grandfathering du référentiel (R229) ; révision chaînée après approbation (R230).
model Trip {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  travelerId    String   @map("traveler_id") @db.Uuid          // le voyageur (créateur)
  status        String   @default("DRAFT")                     // DRAFT|PENDING_APPROVAL|APPROVED|IN_PROGRESS|COMPLETED|CANCELLED
  purpose       String?
  dateStart     String   @map("date_start")                    // ISO date
  dateEnd       String   @map("date_end")
  destinations  Json     @default("[]")                        // string[] (juridictions)
  clients       Json     @default("[]")                        // string[] (clientId visités)
  advisories    Json     @default("[]")                        // [{ jurisdiction, activite, verdict, referentielVersion }] (R223)
  signals       Json     @default("[]")                        // [{ type, severite, detail }] (R224/R228)
  revision      Int      @default(1)                           // R230
  previousTripId String? @map("previous_trip_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")
  @@index([tenantId, travelerId])
  @@map("trips")
}

// Visa d'approbation d'un voyage — visa uniforme R15 (R225).
model TripVisa {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  tripId    String    @map("trip_id") @db.Uuid
  role      String                                             // rôle approbateur requis
  status    String    @default("PENDING")                     // PENDING|SIGNED
  signedBy  String?   @map("signed_by") @db.Uuid
  signedAt  DateTime? @map("signed_at")
  @@index([tenantId, tripId])
  @@map("trip_visas")
}

// ── MOD Décision NBA (R243→R246, lot 53) ────────────────────────────────────
// Une suggestion NBA est générée par le moteur ; une fois PROPOSED, proposition & facteurs sont
// IMMUABLES (R243, explicabilité). La décision est un ÉVÉNEMENT append-only (R244, NBA_DECIDED) ;
// R44 strict : humain seulement, aucune exécution directe (R245) — l'ACCEPT émet l'événement, un
// consommateur (service Tâches) le traduit en tâche. Rejeu à date (R246). Statut mutable (matérialisé).
model NbaSuggestion {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  contexte    String                                      // client | kyc | task
  subjectId   String   @map("subject_id")
  proposition String                                      // R243 : ce que l'humain voit (immuable une fois PROPOSED)
  facteurs    Json     @default("[]")                     // R243 : les facteurs (immuables)
  statut      String   @default("PROPOSED")               // PROPOSED | DECIDED | EXPIRED
  ttlDays     Int?     @map("ttl_days")                   // R243 : expiration paramétrée tenant
  decision    String?                                     // R244 : ACCEPT | ADJUST | REJECT
  adjustment  Json?                                       // R244 : non vide si ADJUST
  rationale   String?                                     // R244 : motif (obligatoire si paramétré)
  decidedBy   String?  @map("decided_by") @db.Uuid        // R244 : acteur humain
  decidedAt   String?  @map("decided_at")                 // ISO — pour le rejeu R246
  createdAt   String   @map("created_at")                 // ISO
  @@index([tenantId, subjectId])
  @@map("nba_suggestions")
}
