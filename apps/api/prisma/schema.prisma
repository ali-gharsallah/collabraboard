// ÉCART SIGNALÉ (lot 39) : le schéma canonique du zip OMET le modèle Task, alors que
// workload.service.ts lit `this.prisma.task` (typé) et que l'amendement R183 déclare son
// contrat (« assigneeId, type, statut OUVERTE|EN_COURS|FAITE, createdAt, doneAt »).
// Modèle reconstruit fidèlement depuis l'amendement + l'usage du service. Cf. rapport lot 39.
model Task {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  assigneeId String    @map("assignee_id")                 // référence applicative vers users.id
  type       String                                        // registre workloadBareme (points par type)
  statut     String    @default("OUVERTE")                 // OUVERTE | EN_COURS | FAITE (R183)
  // Le corpus R183/R185 traite les dates de tâche comme des ISO strings (comparaison
  // lexicale `depuisLe <= doneAt.slice(0,10)`, barème du jour) — champs String, fidèles.
  createdAt  String    @map("created_at")
  doneAt     String?   @map("done_at")                     // R185 : jour de l'accomplissement (barème du jour)
  // ÉCART SIGNALÉ (lot 40) : extension additive du modèle Task (authoré lot 39) — le CRM
  // R187 dérive « le prochain geste » de tâches liées au client et en retard. clientId +
  // dueAt ajoutés en nullable (aucune donnée existante impactée). Cf. rapport lot 40.
  clientId   String?   @map("client_id") @db.Uuid          // R187 — tâche rattachée à un client
  dueAt      String?   @map("due_at")                      // R187 — échéance (ISO), « tâche en retard »
  // ── MOD Tâches (R239→R242, lot 52) : extension ADDITIVE nullable. statut réutilise le
  //    vocabulaire ratifié (OPEN↔OUVERTE, COMPLETED↔FAITE, CANCELLED↔ANNULEE) — workload R183
  //    inchangé (mapping DTO, cf. ECARTS-FRONT). Le sujet est une référence d'agrégat générique. ──
  subjectType     String? @map("subject_type")             // R239 : KYC | TRIP | INSTANCE | CLIENT…
  subjectId       String? @map("subject_id")               // R239 : référence d'agrégat
  origine         String? @map("origine")                  // R239 : type d'événement d'origine (jamais par effet de bord)
  completedBy     String? @map("completed_by") @db.Uuid    // R241 : acteur de la complétion (distinct de l'assignee, tracé)
  completeComment String? @map("complete_comment")         // R241 : commentaire de complétion
  @@index([tenantId, assigneeId])
  @@map("tasks")
}

