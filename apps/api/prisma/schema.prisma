// ── MOD-43 Formations & Certifications (R231→R238, lot 50) ──────────────────
// Le référentiel des formations est 100% tenant (registre `trainingCatalog`, R231).
// L'assignation porte le cycle de vie (R232) ; la complétion est un événement
// (TRAINING_COMPLETED) avec attestation GED. Mode de validation = paramètre tenant
// (R235) : AUTO ou VALIDATED (visa uniforme R15, exclusion 4-yeux R13).
model TrainingAssignment {
  id               String    @id @default(uuid()) @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  userId           String    @map("user_id") @db.Uuid          // le collaborateur
  formationCode    String    @map("formation_code")
  echeance         String                                      // ISO date (R232)
  statut           String    @default("ASSIGNED")              // ASSIGNED|IN_PROGRESS|COMPLETED|EXPIRED (R232)
  attestationDocId String?   @map("attestation_doc_id")        // pièce GED (R232)
  visaStatut       String?   @map("visa_statut")               // R235 mode VALIDATED : PENDING|SIGNED (null = AUTO)
  visePar          String?   @map("vise_par") @db.Uuid
  viseAt           DateTime? @map("vise_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  @@index([tenantId, userId])
  @@map("training_assignments")
}

// Certification : date d'obtention + expiration. APPEND-ONLY (R234) : un renouvellement
