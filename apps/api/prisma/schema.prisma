// Surveillance AML private banking — R189→R206 (Bloc 48, A-69..A-86). Un signal est un
// FAIT append-only, tenant-scopé (RLS FORCE) : le moteur le lève, l'humain l'instruit
// (risk case R133). L'auteur est le jeton (emisPar), jamais le corps. Niveau 1 bloquant =
// suspension de l'opération (sanctions R192, HRI R197, CRS R203).
model AmlSignal {
  id       String   @id @default(uuid()) @db.Uuid
  tenantId String   @map("tenant_id") @db.Uuid
  clientId String   @map("client_id") @db.Uuid
  type     String                                       // STRUCTURING, CROSS_BORDER_CIRCULAR, …
  regle    String                                       // R189..R206
  niveau   Int                                          // 1 = sévère ; 2 = signal
  note     String                                       // le fait, en clair
  motif    String                                       // la qualification (Rxxx)
  bloquant Boolean  @default(false)                     // suspend l'opération (R192/R197/R203)
  emisPar  String   @map("emis_par")                    // jeton — jamais le corps
  at       DateTime @default(now())
  @@index([tenantId, clientId])
  @@map("aml_signals")
}

// Couche de conformité Shariah — R207→R221 (Bloc 49, IS-01..IS-15). Un signal est un FAIT
// append-only, tenant-scopé (RLS FORCE) : le moteur le lève, l'humain l'instruit. Auteur =
// jeton (emisPar). Niveau 1 bloquant = R209 (maysir). revueManuelle = R216 (entité islamique
// caritative sous sanction : jamais d'auto-blocage). Adaptation minimale (option Ali) : un
// seul modèle, pas d'Account/enum ; Zakat/Mudaraba/Waqf/… = calculs + événements ledger.
model IslamicSignal {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  clientId      String   @map("client_id") @db.Uuid
  type          String                                  // ISLAMIC_PROFILE_VIOLATION, RIBA_INCOME, …
  regle         String                                  // R207..R221
  niveau        Int                                     // 1 = sévère ; 2 = signal
  note          String
  motif         String
  bloquant      Boolean  @default(false)                // R209 (maysir) uniquement
  revueManuelle Boolean  @default(false) @map("revue_manuelle") // R216 : surseoir à l'auto-blocage
  emisPar       String   @map("emis_par")               // jeton — jamais le corps
  at            DateTime @default(now())
  @@index([tenantId, clientId])
  @@map("islamic_signals")
}

// Ledgers Shariah — R211/R215/R218 (Bloc 49b, augmentation additive, option Ali). Les
// calculateurs restaient purs + événements ; on PERSISTE désormais leur trace (append-only,
// tenant-scopé, RLS FORCE) pour l'audit AAOIFI. Conventions du dépôt : uuid + @db.Uuid, Int
// (pas de BigInt/cuid), pas de modèle Account — le clientId/waqfId sont des références
// applicatives (comme partout ailleurs). Auteur = jeton (emisPar).
model ZakatCalculation {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  clientId    String   @map("client_id") @db.Uuid
  annee       Int
  totalWealth Int      @map("total_wealth")             // CHF
  nisab       Int
  zakatDue    Int      @map("zakat_due")                // 2,5% si assujetti, sinon 0
  statut      String                                    // PENDING_PAYMENT | NON_ASSUJETTI
  emisPar     String   @map("emis_par")
  at          DateTime @default(now())
  @@index([tenantId, clientId, annee])
  @@map("zakat_calculations")
}

