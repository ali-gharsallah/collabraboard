{
  "compilerOptions": {
    "target": "es2020",
    "lib": ["ES2020"],
    "types": ["node"],
    "module": "commonjs",
    "moduleResolution": "node",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@olive/shared/*": ["../../packages/shared/*"],
      "@olive/shared": ["../../packages/shared/src/contracts"]
    }
  },
  "include": ["src"],
  "exclude": [
    "src/modules/coffre/s3-storage.adapter.ts"
  ]
}
