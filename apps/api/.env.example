# O-Live API — variables d'environnement (exemple). `cp .env.example .env` puis renseigner.
# JAMAIS de valeur réelle ici : uniquement des gabarits.

# ── Base de données ──
DATABASE_URL=postgresql://olive:olive@localhost:5433/olive_test

# ── Secrets obligatoires au boot (fail-fast volontaire, cf. RUNBOOK §1) ──
AUDIT_HMAC_SECRET=<hex 32 octets — audit sans valeur probante sinon>
MFA_ENC_KEY=<hex 32 octets — chiffrement mfa_secret>

# ── SSO / OIDC (le login OIDC refuse proprement sans OIDC_JWKS_URI, cf. RUNBOOK §3.4) ──
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URI=

# ── Licence vendor (R177→R179, lot 37) ──
# Clé publique du vendor servant à VÉRIFIER la signature de la licence à chaque lecture.
# Défaut-refus : sans clé, aucune licence n'est tenue pour valide. Jamais la clé privée ici.
VENDOR_LICENSE_KEY=<clé publique de vérification vendor>

# ── Coffre Exoscale SOS (optionnel, activé par tenant — cf. RUNBOOK §6) ──
EXOSCALE_SOS_KEY=
EXOSCALE_SOS_SECRET=
EXOSCALE_SOS_BUCKET=
